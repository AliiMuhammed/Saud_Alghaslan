<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- === Inquiries Page === -->
        <template id="s_saud_inquiries_page" name="Inquiries">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure">
                    <section class="s_saud_inquiries_page mb-80 py-5 bg-white" 
                             data-snippet="s_saud_inquiries_page"
                             data-name="Saud Inquiries">
                        <div class="container">
                            <div class="row justify-content-center">
                                <div class="col-12 col-xl-10">
                                    <h1 class="text-secondary fw-bold  mb-4 mb-lg-5">للاستفسارات</h1>

                                    <div class="s_saud_inquiries_card bg-white shadow-sm overflow-hidden">
                                        <div class="s_saud_inquiries_form row g-0 align-items-stretch">
                                            <div class="right col-12 col-lg-6">
                                                <div class="s_saud_inquiries_info bg-primary text-white h-100 p-4 p-md-5 d-flex flex-column justify-content-start ">
                                                    <h2 class="s_saud_inquiries_info_title fw-bold text-white mb-3">
                                                        نحن نقدر اقتراحاتك
                                                    </h2>
                                                    <span class="s_saud_inquiries_info_line mb-4"></span>

                                                    <p class="small text-white mb-4 mb-lg-5 lh-lg">
                                                        نحرص دائمًا على تطوير خدماتنا بما يرضي عملاءنا الكرام. دعوكم
                                                        لتقديم مقترحاتكم أو أفكاركم المميزة فهي مفتاح التطوير
                                                        والابتكار. شكرًا لتعاونكم وثقتكم بنا.
                                                    </p>

                                                    <div class="d-flex align-items-start gap-3 mb-3">
                                                        <span class="s_saud_inquiries_icon rounded-circle d-inline-flex align-items-center justify-content-center">
                                                            <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                                                        </span>
                                                        <div>
                                                            <h6 class="fw-bold text-white mb-2">العنوان</h6>
                                                            <p class="small text-white mb-0 lh-base">
                                                                طريق الأمير مقرن بن عبدالعزيز، حائل 55425، المملكة
                                                                العربية السعودية
                                                            </p>
                                                        </div>
                                                    </div>

                                                    <div class="d-flex align-items-start gap-3 mb-3">
                                                        <span class="s_saud_inquiries_icon rounded-circle d-inline-flex align-items-center justify-content-center">
                                                            <i class="fa-solid fa-phone" aria-hidden="true"></i>
                                                        </span>
                                                        <div>
                                                            <h6 class="fw-bold text-white mb-2">الهاتف</h6>
                                                            <p class="small text-white mb-0">0165311111</p>
                                                        </div>
                                                    </div>

                                                    <div class="d-flex align-items-start gap-3">
                                                        <span class="s_saud_inquiries_icon rounded-circle d-inline-flex align-items-center justify-content-center">
                                                            <i class="fa-regular fa-clock" aria-hidden="true"></i>
                                                        </span>
                                                        <div>
                                                            <h6 class="fw-bold text-white mb-2">مواعيد العمل</h6>
                                                            <p class="small text-white mb-0 lh-base">
                                                                من السبت إلى الأربعاء، 8:30 ص - 12:30 م / 4:00 م -
                                                                8:30 م
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="left col-12 col-lg-6 bg-white p-4 p-md-5">
                                                <form class="contact-card js-saud-inquiries-form d-flex flex-column gap-4"
                                                      method="post"
                                                      action="/saud/inquiries/lead"
                                                      novalidate="novalidate">
                                                    <input type="hidden" name="csrf_token"
                                                           t-att-value="request.csrf_token()"/>

                                                    <div class=" mb-4">
                                                        <h2 class="form-title s_saud_inquiries_form_title fw-bold mb-3">
                                                            رأيك أو سؤالك
                                                        </h2>
                                                    </div>

                                                    <div class="form-input">
                                                        <input type="text"
                                                               name="inquiry_name"
                                                               class="form-control"
                                                               placeholder="الاسم"
                                                               autocomplete="name"/>
                                                        <p class="form-error"></p>
                                                    </div>

                                                    <div class="form-input">
                                                        <input type="tel"
                                                               name="inquiry_phone"
                                                               class="form-control"
                                                               placeholder="الهاتف"
                                                               autocomplete="tel"/>
                                                        <p class="form-error"></p>
                                                    </div>

                                                    <div class="form-input">
                                                        <textarea name="inquiry_message"
                                                                  class="form-control"
                                                                  rows="5"
                                                                  placeholder="رسالتك"></textarea>
                                                        <p class="form-error"></p>
                                                    </div>

                                                    <div class="text-center">
                                                        <button type="submit"
                                                                class="btn btn-primary w-100 contact-submit">
                                                            ارسل رسالتك
                                                        </button>
                                                    </div>

                                                    <p class="js-saud-inquiries-feedback saud-contactus-feedback text-center mb-0 d-none"></p>

                                                    <p class="small text-muted text-center mb-0">
                                                        بالنقر فوق الزر أعلاه، أوافق على شروط الاستخدام وسياسة
                                                        الخصوصية الخاصة بموقعكم وأوافق على تلقي الرسائل النصية القصيرة
                                                        ورسائل البريد الإلكتروني.
                                                    </p>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </t>
        </template>
        <record id="s_saud_inquiries_route" model="theme.website.page">
            <field name="view_id" ref="s_saud_inquiries_page"/>
            <field name="is_published" eval="True"/>
            <field name="url">/inquiries</field>
        </record>
    </data>
</odoo>
