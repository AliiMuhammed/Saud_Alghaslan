<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- === About Us Page === -->
        <template id="s_saud_about_page" name="About Us">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure">
                    <!-- Hero Section -->
                    <t t-call="theme_saud.hero_section_component">
                        <t t-set="hero_bg_image" t-value="'/theme_saud/static/src/img/hero_about.webp'"/>
                        <t t-set="hero_title" t-value="'من نحن!'"/>
                        <t t-set="hero_subtitle"
                           t-value="'نؤمن بأن العقارات ليست مجرد مبانٍ؛ بل هي أماكن تنبض بالحياة وتصنع الذكريات.'"/>
                        <t t-set="hero_button_text" t-value="'إنضم إلينا'"/>
                        <t t-set="hero_button_url" t-value="'/aboutus#services'"/>
                    </t>
                    <!-- Our story Section-->
                    <section class="s-saud-our-story mb-80">
                        <div class="container d-flex justify-content-center align-items-center">
                            <div class="s-saud-our-story__content row align-items-center g-5 gy-5">
                                <!-- Image Column -->
                                <div class="col-lg-5">
                                    <div class="s-saud-our-story__media overflow-hidden rounded-3">
                                        <div class="row g-1">
                                            <div class="col-6">
                                                <div class="ratio ratio-4x3">
                                                    <img src="/theme_saud/static/src/img/Our_story_2.webp"
                                                         alt="Our story image 2"
                                                         class="w-100 h-100 object-fit-cover gray-filter"
                                                         loading="lazy"/>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="ratio ratio-4x3">
                                                    <img src="/theme_saud/static/src/img/Our_story_1.webp"
                                                         alt="Our story image 1"
                                                         class="w-100 h-100 object-fit-cover"
                                                         loading="lazy"/>
                                                </div>
                                            </div>
                                            <div class="col-12">
                                                <div class="ratio ratio-21x9">
                                                    <img src="/theme_saud/static/src/img/Our_story_3.webp"
                                                         alt="Our story image 3"
                                                         class="w-100 h-100 object-fit-cover gray-filter"
                                                         loading="lazy"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- Content Column -->
                                <div class="col-lg-6 text-center text-lg-start">
                                    <!-- Title -->
                                    <h2 class="text-primary fw-bold mb-3 s_saud_info_title">
                                        قصتنا
                                    </h2>
                                    <!-- Description -->
                                    <p class="text-muted lh-lg mb-4">
                                        سعود الغسلان العقارية، إحدى الشركات العقارية الطموحة للوصول إلى الريادة في
                                        مجال الاستثمار والتطوير العقاري، إذ تمتلك الشركة الكفاءات المهنية المؤهلة
                                        لتحقيق أهدافها من خلال خبراتهم وشغفهم للعمل.
                                    </p>
                                    <p class="text-primary lh-lg">
                                        تأسست شركة سعود الغسلان العقارية على يد الشيخ/ سليمان بن علي الغسلان رحمه
                                        الله في سبعينيات القرن الماضي، وعلى امتداد أكثر من أربعين عامًا سعت الشركة
                                        إلى تطوير أعمالها في مجال العقارات.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- Ambition Section -->
                    <section class="s-saud-ambition-section mb-80 py-5 bg-body-tertiary bg-opacity-25">
                        <!--   main section title     -->
                        <t t-call="theme_saud.main_section_title">
                            <t t-set="main_title" t-value="'طموح ومسؤولية'"/>
                            <t t-set="main_subtitle"
                               t-value="'نحن نؤمن بأن الرؤية الطموحة والرسالة الواضحة والقيم الصادقة هي أساس نجاحنا.'"/>
                        </t>
                        <!--Benefits Section-->
                        <t t-call="theme_saud.benefits_component">
                            <t t-set="benefits" t-value="[
                    {'icon': 'fa-solid fa-eye',       'title': 'روئيتنا',      'desc': 'نتطلع لأن نكون الرواد في تحقيق أفضل الاستثمارات وتقديم أنسب الحلول والخدمات العقارية بما يتناسب مع تطلعات عملاىنا.'},
                    {'icon': 'fa-solid fa-envelope-circle-check',           'title': 'رسالتنا',       'desc': 'نسعى لخلق أفضل الفرص الاستثمارية عبر تقديم حلول متنوعة وتجارب مبتكرة تواكب حركة السوق النشط.'},
                    {'icon': 'fa-solid fa-book',            'title': 'قيمنا',     'desc': 'في جميع ما نقوم به من أعمال لتحقيق, أهدافنا لا نتوانا عن القيم التالية:

+ الأمانة. + الشفافية. + الإحترام.
+ الإتقان. + الإبداع.

نتعاون جميعًا لتحقيق رضا عملائنا، بما يخدم مصلحة مجتمعنا.'},
                ]"/>
                        </t>
                    </section>
                    <!-- How We Work section -->
                    <section class="s_saud_how_work o_colored_level"
                             data-snippet="s_saud_how_work_steps" data-name="How We Work Steps"
                             data-saud-reveal-initialized="true">
                        <div class="s_saud_section_title pb-5 container d-flex justify-content-center align-items-center flex-column">
                            <h2 class="s_saud_main_title text-primary fw-semibold lh-lg m-0 o_default_snippet_text">كيف
                                نعمل
                            </h2>
                            <p class="s_saud_main_subtitle text-muted fw-normal text-center m-0 o_default_snippet_text">
                                نقدم لك تجربة منظمة وواضحة من أول خطوة حتى اكتمال الخدمة.
                            </p>
                        </div>
                        <div class="container">
                            <div class="row row-cols-1 row-cols-md-3 g-4 g-xl-5 justify-content-center s_saud_how_work_steps">
                                <div class="col s_saud_how_work_step_item o_colored_level" data-name="How We Work Step">
                                    <article
                                            class="s_saud_how_work_step h-100 s_saud_reveal s_saud_reveal--zoom s_saud_reveal--delay-2 s_saud_reveal--ready is-visible"
                                            data-saud-reveal-initialized="true">
                                        <div class="s_saud_how_work_step_number text-primary o_not_editable"
                                             aria-hidden="true"/>
                                        <div class="s_saud_how_work_step_content">
                                            <h3 class="s_saud_how_work_step_title fs-5 lh-sm fw-semibold">&amp;nbsp;التقييم
                                                والاستشارة
                                            </h3>
                                            <p class="s_saud_how_work_step_description text-muted mb-0 small lh-base">
                                                &amp;nbsp;نبدأ
                                                بفهم احتياجات العملاء وتقديم استشارات مخصصة حول أفضل الطرق لتحقيق
                                                أهدافهم
                                                العقارية، مع دراسة السوق وتقييم الفرص المتاحة.
                                            </p>
                                        </div>
                                    </article>
                                </div>
                                <div class="col s_saud_how_work_step_item o_colored_level" data-name="How We Work Step">
                                    <article
                                            class="s_saud_how_work_step h-100 s_saud_reveal s_saud_reveal--zoom s_saud_reveal--delay-3 s_saud_reveal--ready is-visible"
                                            data-saud-reveal-initialized="true">
                                        <div class="s_saud_how_work_step_number text-primary o_not_editable"
                                             aria-hidden="true"/>
                                        <div class="s_saud_how_work_step_content">
                                            <h3 class="s_saud_how_work_step_title fs-5 lh-sm fw-semibold">&amp;nbsp;التطوير
                                                والتسويق
                                            </h3>
                                            <p class="s_saud_how_work_step_description text-muted mb-0 small lh-base">
                                                &amp;nbsp;نعمل
                                                على تطوير العقارات بما يتناسب مع احتياجات السوق، مع إعداد خطط تسويقية
                                                فعالة لجذب
                                                المشترين والمستثمرين، وضمان الوصول لأفضل العوائد الاستثمارية.
                                            </p>
                                        </div>
                                    </article>
                                </div>
                                <div class="col s_saud_how_work_step_item o_colored_level" data-name="How We Work Step">
                                    <article
                                            class="s_saud_how_work_step h-100 s_saud_reveal s_saud_reveal--zoom s_saud_reveal--delay-4 s_saud_reveal--ready is-visible"
                                            data-saud-reveal-initialized="true">
                                        <div class="s_saud_how_work_step_number text-primary o_not_editable"
                                             aria-hidden="true"/>
                                        <div class="s_saud_how_work_step_content">
                                            <h3 class="s_saud_how_work_step_title fs-5 lh-sm fw-semibold">&amp;nbsp;التنفيذ
                                                والإدارة
                                            </h3>
                                            <p class="s_saud_how_work_step_description text-muted mb-0 small lh-base">
                                                نقوم بتنفيذ مشاريع العقارات مع الالتزام بأعلى معايير الجودة، ونتولى
                                                إدارة
                                                الممتلكات وضمان توفير الخدمات المناسبة للمستأجرين والمشترين، مما يعزز
                                                رضا
                                                العملاء ويحقق الاستدامة المالية.
                                            </p>
                                            <p class="s_saud_how_work_step_description text-muted mb-0 small lh-base">
                                                &amp;nbsp;
                                                <br/>
                                            </p>
                                        </div>
                                    </article>
                                </div>
                            </div>
                        </div>
                    </section>
                    <t t-call="theme_saud.testimonials_carousel">
                        <t t-set="testimonials_extra_class" t-value="'mb-80'"/>
                        <t t-set="testimonials" t-value="[
                    {
                        'text': 'اخترت الشركة لمساعدتي في استثمار أموالي في العقارات، قدموا لي استشارات دقيقة ومفيدة ساعدتني في اتخاذ القرار الصحيح، وكل ذلك بفضل احترافيتهم وتفانيهم في العمل.',
                        'image': '/theme_saud/static/src/img/Testimonial-1.webp',
                        'name': 'رائد فارس',
                        'title': 'رجل أعمال'
                    },
                    {
                        'text': 'شعرت بالراحة والثقة. الفريق كان محترفاً وقدم لي جميع المعلومات التي أحتاجها، مما جعل عملية شراء المنزل الجديد تجربة مريحة وسلسة. أنصح بشدة باستخدام خدماتهم لأي شخص يبحث عن عقار.',
                        'image': '/theme_saud/static/src/img/Testimonial-2.webp',
                        'name': 'الهنوف عبدالعزيز',
                        'title': 'مدرسة'
                    }
                ]"/>
                    </t>
                    <!-- CounterUp section -->
                    <section class="s-saud-our-numbers py-5 mb-80 bg-body-tertiary bg-opacity-25">
                        <t t-call="theme_saud.counter_up_section">
                            <t t-set="counter_main_title" t-value="'أرقامنا في سوق العقار'"/>
                            <t t-set="counter_main_subtitle"
                               t-value="'فخورون بإنجازاتنا ونجاحاتنا في المجال العقاري، وما كان ذلك إلا بفضل وتوفيق من الله تعالى، ثم بفضل التزامنا بقيمنا وأهدافنا.'"/>

                            <t t-set="counter_items" t-value="[
        {
            'icon': 'fa-solid fa-coins',
            'target': 600,
            'prefix': 'M',
            'suffix': '+',
            'use_comma': False,
            'title': 'حجم استثماراتنا'
        },
        {
            'icon': 'fa-solid fa-house-chimney',
            'target': 21000,
            'prefix': '',
            'suffix': '+',
            'use_comma': True,
            'title': 'عقار تم بيعه'
        },
        {
            'icon': 'fa-solid fa-hard-hat',
            'target': 211,
            'prefix': '',
            'suffix': '',
            'use_comma': False,
            'title': 'مشروع تم إنجازه'
        },
        {
            'icon': 'fa-solid fa-lightbulb',
            'target': 40,
            'prefix': '',
            'suffix': '+',
            'use_comma': False,
            'title': 'عاماً من الخبرة'
        }
    ]"/>
                        </t>
                    </section>
                    <!--Speech of the Chairman-->
                    <section class="s-saud-Speech mb-80">
                        <div class="container d-flex justify-content-center align-items-center">
                            <div class="s-saud-Speech__content row align-items-center g-5 gy-5">
                                <!-- Image Column -->
                                <div class="col-lg-5">

                                    <div class="s-saud-Speech__media overflow-hidden rounded-3">
                                        <img src="/theme_saud/static/src/img/Chairman.webp"
                                             alt="Chairman"
                                             class="w-100 h-100 object-fit-cover "
                                             loading="lazy"/>
                                    </div>
                                </div>
                                <!-- Content Column -->
                                <div class="col-lg-6 text-center text-lg-start">
                                    <!-- Title -->
                                    <h2 class="text-primary fw-bold mb-3 s_saud_info_title">
                                        كلمة رئيس مجلس الإدارة
                                    </h2>
                                    <!-- Description -->
                                    <p class=" fw-medium lh-lg mb-2">
                                        بسم الله الرحمن الرحيم
                                        <br/>
                                        الحمد لله والصلاة والسلام على رسول الله، وبعد:
                                    </p>
                                    <p class=" fw-medium lh-lg mb-2">
                                        نحمد الله تعالى أن مَنَّ علينا ببلوغ عامنا الخامس والأربعون في خدمة وطننا
                                        الغالي، فمنذ سبعينيات القرن الماضي، أسس والدنا المغفور له بإذن الله تعالى الشيخ/
                                        سليمان بن علي الغسلان، هذا الكيان الاستثماري الغالي، والذي أخذنا على عاتقنا
                                        عهداً بالمحافظة عليه لتحقيق المهمة الأولى التي كلف الله بها الإنسان وهي عمارة
                                        الأرض.
                                    </p>
                                    <p class="  fw-medium text-primary lh-lg mb-2">
                                        منذ ذلك الحين؛ لم نألوا جهداً في تحقيق رؤيتنا المستقبلية، وذلك بتوفير مناخ
                                        استثماري ملائم لنيل ثقة كبار المستثمرين، والذين نفخر بخدمتهم عبر العديد من
                                        البرامج الاستثمارية التي تلائم تطلعاتهم، محافظين على قيمنا الراسخة، والتي كسبنا
                                        من خلالها أيضاً ثقة عملاؤنا المستفيدون من خدماتنا المتنوعة التي تلبي إحتياجاتهم
                                        وذلك من خلال فريق عمل مؤهل لتقديم جميع الخدمات العقارية بحوكمة منضبطة لتحقيق
                                        معايير الجودة ملتزمين إلتزاماً كاملاً في جميع تعاملاتنا بضوابط الشريعة
                                        الإسلامية.
                                    </p>
                                    <p class="  fw-medium lh-lg mb-2">
                                        وفق الله الجميع لما يحبه ويرضاه، والسلام عليكم ورحمة الله وبركاته.
                                    </p>
                                    <p class="lh-lg fw-medium fs-5 text-primary m-0">
                                        سعود بن سليمان الغسلان
                                    </p>
                                    <p class="lh-lg fw-medium small text-muted m-0">
                                        رئيس مجلس الإدارة
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- Trusted By section -->
                    <t t-call="theme_saud.trusted_by_section">
                        <t t-set="trusted_extra_class" t-value="'py-5 bg-body-tertiary bg-opacity-25'"/>
                    </t>
                    <section
                            class="s_saud_cta_banner o_colored_level oe_img_bg o_bg_img_center position-relative overflow-hidden text-center text-white d-flex align-items-center justify-content-center py-5"
                            data-snippet="s_saud_cta_banner" data-name="Saud CTA Banner"
                            style="background-image: url('/theme_saud/static/src/img/hero_about.webp'); background-position: 50% 50%;">
                        <div class="s_saud_cta_banner__overlay"/>
                        <div class="container s_allow_columns position-relative">
                            <div class="row justify-content-center">
                                <div class="col-12 col-lg-8 o_colored_level">
                                    <h2 class="text-white fw-bold mb-3 o_default_snippet_text">نحن هنا لخدمتك</h2>
                                    <p class="text-white small mb-4 o_default_snippet_text">تواصل معنا الآن لتحقيق
                                        طموحاتك العقارية!
                                    </p>
                                    <a href="/contactus"
                                       class="btn btn-primary px-5 py-2 d-inline-flex align-items-center justify-content-center o_default_snippet_text">
                                        اتصل بنا
                                    </a>
                                </div>
                            </div>
                        </div>
                    </section>

                </div>
            </t>
        </template>
        <record id="s_saud_about_route" model="theme.website.page">
            <field name="view_id" ref="s_saud_about_page"/>
            <field name="is_published" eval="True"/>
            <field name="url">/aboutus</field>
        </record>
        <record id="s_saud_about_menu" model="theme.website.menu">
            <field name="name">من نحن</field>
            <field name="url">/aboutus</field>
            <field name="page_id" ref="s_saud_about_route"/>
            <field name="sequence" type="int">20</field>
        </record>
    </data>
</odoo>
