<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- === Ruba Page === -->
        <template id="s_saud_ruba_page" name="Ruba Plan">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure">
                    <!-- Hero Section -->
                    <t t-call="theme_saud.hero_section_component">
                        <t t-set="hero_bg_image" t-value="'/theme_saud/static/src/img/ruba_hero.webp'"/>
                        <t t-set="hero_title" t-value="'مخطط رُبـــى'"/>
                        <t t-set="hero_subtitle" t-value="'فخامـــة المـــكان.'"/>
                        <t t-set="hero_button_text" t-value="'احجز الآن'"/>
                        <t t-set="hero_button_url" t-value="'/#booking'"/>
                        <t t-set="hero_extra_class" t-value="'s_saud_ruba_hero mb-0'"/>
                        <!--<t t-set="hero_show_overlay" t-value="False"/>-->
                    </t>
                    <!--Booking Form-->
                    <section class="s_saud_ruba_booking mb-80 py-5 bg-body-tertiary bg-opacity-25">
                        <div class="container">
                            <div class="s_saud_ruba_booking_form row gx-5 align-items-stretch justify-content-center">
                                <div class="left  col-12 col-md-12 col-lg-5">
                                    <form class="contact-card bg-white shadow-sm p-4 p-md-5  mb-3 js-saud-ruba-booking-form d-flex flex-column gap-4"
                                          method="post"
                                          action="/saud/ruba/lead"
                                          novalidate="novalidate">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                        <div class="text-start mb-5">
                                            <h1 class="form-title s_saud_ruba_booking_form_title fw-bold text-primary  mb-3">
                                                احجــــــز الآن
                                            </h1>
                                            <p class="text-muted mb-3">نحن هنا لنحوّل طموحاتك إلى واقع. تواصل معنا الآن
                                                لتبدأ رحلتك في رُبى.
                                            </p>
                                        </div>

                                        <div class="form-input">
                                            <input type="text"
                                                   name="ruba_name"
                                                   class="form-control"
                                                   placeholder="الاسم"
                                                   autocomplete="name"/>
                                            <p class="form-error"></p>
                                        </div>

                                        <div class="form-input">
                                            <input type="tel"
                                                   name="ruba_phone"
                                                   class="form-control"
                                                   placeholder="الهاتف"
                                                   autocomplete="tel"/>
                                            <p class="form-error"></p>
                                        </div>

                                        <div class="form-input">
                                            <input type="email"
                                                   name="ruba_email"
                                                   class="form-control"
                                                   placeholder="البريد الإلكتروني"
                                                   autocomplete="email"/>
                                            <p class="form-error"></p>
                                        </div>

                                        <div class="form-input">
                                            <select name="ruba_purchase_interest" class="form-select">
                                                <option value="" selected="selected" disabled="disabled">رغبة الشراء
                                                </option>
                                                <option value="قطعة سكنية">قطعة سكنية</option>
                                                <option value="قطعة تجارية">قطعة تجارية</option>
                                                <option value="أكثر من قطعة سكنية">أكثر من قطعة سكنية</option>
                                                <option value="أكثر من قطعة تجارية">أكثر من قطعة تجارية</option>
                                                <option value="أخري">أخري</option>
                                            </select>
                                            <p class="form-error"></p>
                                        </div>

                                        <div class="form-input">
                                            <select name="ruba_source" class="form-select">
                                                <option value="" selected="selected" disabled="disabled">كيف تعرفت علي
                                                    مخطط رُبـــى؟
                                                </option>
                                                <option value="لينكد إن">لينكد إن</option>
                                                <option value="يوتيوب">يوتيوب</option>
                                                <option value="سناب شات">سناب شات</option>
                                                <option value="إنستغرام">إنستغرام</option>
                                                <option value="فيسبوك">فيسبوك</option>
                                                <option value="اكس (تويتر سابقًا)">اكس (تويتر سابقًا)</option>
                                                <option value="أخري">أخري</option>
                                            </select>
                                            <p class="form-error"></p>
                                        </div>

                                        <div class="form-input">
                                            <textarea name="ruba_notes"
                                                      class="form-control"
                                                      rows="5"
                                                      placeholder="ملاحظات"></textarea>
                                            <p class="form-error"></p>
                                        </div>

                                        <div class="text-center">
                                            <button type="submit"
                                                    class="btn btn-primary w-100 contact-submit">
                                                إرسال
                                            </button>
                                        </div>

                                        <p class="js-saud-ruba-booking-feedback saud-contactus-feedback text-center mb-0 d-none"></p>

                                        <p class="small text-muted text-center mb-0">
                                            بالنقر فوق الزر أعلاه، أوافق على شروط الاستخدام وسياسة الخصوصية الخاصة
                                            بموقعك وأوافق على تلقي الرسائل النصية القصيرة ورسائل البريد الإلكتروني.
                                        </p>
                                    </form>
                                    <div class="s_saud_contact_info d-flex gap-4 p-4 pb-4 pb-md-0 ">
                                        <a href="https://wa.me/966165311111" target="_blank"
                                           class="s_saud_whatsApp_icon d-flex align-items-center justify-content-center text-white bg-primary fs-4 p-2 rounded-circle">
                                            <i class="fa-brands fa-whatsapp"></i>
                                        </a>
                                        <div class="d-flex flex-column gap-2">
                                            <a class="fw-medium fs-5 text-secondary" href="https://wa.me/966165311111"
                                               target="_blank">
                                                للتواصل والاستفسار:
                                            </a>
                                            <p class="text-muted fs-5">0165311111 - 0553487111</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="right col-12  col-md-12 col-lg-5">
                                    <div class="s_saud_ruba_map h-100">
                                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3539.0004327097245!2d41.7049945!3d27.500362!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x1576471489d91b59%3A0xbfff8ebe3a388a2b!2z2LTYsdmD2Kkg2LPYudmI2K8g2KfZhNi62LPZhNin2YYg2KfZhNi52YLYp9ix2YrYqSBTR1JFQ08!5e0!3m2!1sen!2seg!4v1778345321457!5m2!1sen!2seg"
                                                class="h-100 w-100"
                                                height="450" style="border:0;" allowfullscreen="" loading="lazy"
                                                referrerpolicy="no-referrer-when-downgrade"></iframe>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- Ruba Details -->
                    <section class="s_saud_ruba_details mb-80">
                        <div class="container">
                            <div class="s_saud_ruba_details_header">
                                <t t-call="theme_saud.main_section_title">
                                    <t t-set="main_title" t-value="'رُبــــــــى'"/>
                                    <t t-set="main_subtitle"
                                       t-value="'مكان يحتضن الأحلام'"/>
                                    <t t-set="main_title_extra_class" t-value="'s_saud_ruba_details_title'"/>
                                </t>
                                <p class="text-muted text-center lh-base mb-4 mb-md-5">وُلد مشروع رُبى ليجسّد مفهوم
                                    المكان الذي يجمع
                                    كل ما يحتاجه الإنسان
                                    ليعيش، يعمل، ويطمح. مكان يحرّك الخيال، ويمنح الفرص، ويعكس هوية متكاملة تجمع بين
                                    الهدوء
                                    والإنجاز. مكان يحتضن الأحلام، ويصنع منها واقعًا ملموسًا في قلب مدينة حائل.
                                </p>
                            </div>
                            <div class="s_saud_ruba_details_content">

                                <!-- TOP ROW: img1 | text2 | img2 -->
                                <div class="row justify-content-center g-4 g-lg-5 mt-2 align-items-stretch">

                                    <!-- Col 1 top: image -->
                                    <div class="col-12  col-lg-4 d-flex justify-content-center align-items-center">
                                        <div class="s_saud_ruba_details_media  w-100 align-self-start">
                                            <img src="/theme_saud/static/src/img/ruba_2.webp"
                                                 alt="رُبى - الإنسان أولوية"
                                            />
                                        </div>
                                    </div>

                                    <!-- Col 2 top: text -->
                                    <div class="col-12  col-lg-4 d-flex">
                                        <div class="s_saud_ruba_details_item  d-flex flex-column justify-content-start">
                                            <h3 class="fw-bold mb-3">حيث يبدأ المستقبل</h3>
                                            <p class="text-muted lh-lg ">
                                                وُلد هذا المشروع ليكون أكثر من مجرد وجهة سكنية: إنه رؤية
                                                متكاملة لحياة تنبض بالأمان والجمال والفرص. في قلب مدينة حائل
                                                النابض بالحيوية، يجمع بين عناصر الراحة والعملية، ليمنح سكانه
                                                بيئة متوازنة تتيح لهم الاستقرار والنمو، سواء على المستوى
                                                الشخصي أو المهني. هنا، لا يقتصر الأمر على السكن فحسب، بل
                                                يمتد ليشمل أسلوب حياة متكامل يراعي احتياجات الأسرة، ويعزز
                                                من جودة الحياة اليومية.
                                            </p>
                                        </div>
                                    </div>

                                    <!-- Col 3 top: image -->
                                    <div class="col-12  col-lg-4 d-flex justify-content-center align-items-center">
                                        <div class="s_saud_ruba_details_media  w-100 align-self-start">
                                            <img src="/theme_saud/static/src/img/ruba_1.webp"
                                                 alt="رُبى - حيث تُصنع الحكايات"
                                            />
                                        </div>
                                    </div>

                                </div>

                                <!-- BOTTOM ROW: text1 | img3 | text3 -->
                                <div class="row justify-content-center g-4 g-lg-5 mt-0 align-items-stretch">

                                    <!-- Col 1 bottom: text -->
                                    <div class="col-12  col-lg-4 d-flex">
                                        <div class="s_saud_ruba_details_item   d-flex flex-column justify-content-start">
                                            <h3 class="fw-bold mb-3">حيث تُصنع الحكايات</h3>
                                            <p class="text-muted lh-lg ">
                                                في هذا المكان، تتداخل تفاصيل العيش والعمل والعطاء ضمن
                                                منظومة مدروسة تفتح آفاقًا جديدة لكل من يختاره. من المرافق
                                                التعليمية والصحية، إلى المساحات الخضراء والمراكز المجتمعية،
                                                ضُمَّ كل عنصر ليكون جزءًا من قصة نجاح قريبة وجماعية. إنه
                                                مشروع يرك بأحلام المستقبل، ويصنع حكايات جديدة تتسقها
                                                الأجيال في بيئة آمنة، لبنة، ومليئة بالإمكانات.
                                            </p>
                                        </div>
                                    </div>

                                    <!-- Col 2 bottom: image -->
                                    <div class="col-12  col-lg-4 d-flex justify-content-center align-items-center">
                                        <div class="s_saud_ruba_details_media w-100 align-self-start">
                                            <img src="/theme_saud/static/src/img/ruba_3.webp"
                                                 alt="رُبى - حيث يبدأ المستقبل"
                                            />
                                        </div>
                                    </div>

                                    <!-- Col 3 bottom: text -->
                                    <div class="col-12  col-lg-4 d-flex">
                                        <div class="s_saud_ruba_details_item  d-flex flex-column justify-content-start">
                                            <h3 class="fw-bold mb-3">الإنسان أولوية</h3>
                                            <p class="text-muted lh-lg ">
                                                في رُبى، يتجلى الاهتمام بالإنسان في كل زاوية وكل تفصيلة،
                                                حيث تتبع فلسفة التصميم من رؤية تضع راحته وجودته في المقام
                                                الأول. لا يُنظر إلى السكن هنا كمجرد مبنى، بل كبيئة متكاملة
                                                تعزز رفاهية الفرد والأسرة، وتراعي احتياجاتهم اليومية من خلال
                                                تخطيط مدروس يوازن بين الجمال والوظيفة، الأجواء الهادئة
                                                والأمان لتهيئة مساحة مثالية للعيش والعمل والعطاء. في رُبى،
                                                الإنسان ليس مجرد ساكن، بل محور لكل فكرة تُبنى حوله.
                                            </p>
                                        </div>
                                    </div>


                                </div>

                            </div>

                        </div>


                    </section>
                    <!-- Ruba Locations -->
                    <section
                            class="s_saud_ruba_locations position-relative overflow-hidden bg-primary d-flex flex-column justify-content-center align-items-center">

                        <div class="s_saud_ruba_locations_background w-100">
                            <div class="container position-relative text-center text-white py-5">

                                <div class="s_saud_ruba_locations_header">
                                    <h2 class="fw-bold mb-2">مخطط رُبـــى</h2>
                                    <p class="fw-medium small mb-0">موقعٌ ليس له مثيل</p>
                                </div>

                                <div class="s_saud_ruba_locations_paragraphs row g-4 pt-5 pb-0 py-md-5">
                                    <p class="col-12 col-md-6 small text-start mb-0 lh-lg">
                                        يتميز هذا الموقع الاستراتيجي بكونه نقطة محورية في قلب مدينة حائل، حيث يجمع بين
                                        الحيوية والراحة في آنٍ واحد. يقع بالقرب من مجموعة من المدارس المرموقة التي تلبي
                                        احتياجات مختلف المراحل التعليمية، مما يجعله خيارًا مثاليًا للعائلات الباحثة عن
                                        بيئة تعليمية متكاملة لأبنائها. كما تحيط به مجموعة من المراكز التجارية الحديثة
                                        التي توفر تجربة تسوق متميزة، بالإضافة إلى مطاعم ومقاهي متنوعة تلبي مختلف
                                        الأذواق، مما يعزز من جودة الحياة اليومية للسكان.
                                    </p>

                                    <p class="col-12 col-md-6 small text-start mb-0 lh-lg">
                                        لا يقتصر تميز الموقع على الجانب التعليمي والتجاري فحسب، بل يمتد ليشمل القرب من
                                        المرافق الصحية المتطورة، مثل المستشفيات والمراكز الطبية، التي تضمن سهولة الوصول
                                        إلى خدمات الرعاية الصحية عند الحاجة. هذا الموقع يجمع بين الراحة والعملية، ويمنح
                                        سكانه فرصة الاستمتاع بحياة متوازنة تجمع بين العمل، التعليم، والترفيه، في بيئة
                                        حضرية نابضة بالحياة وآمنة في الوقت ذاته.
                                    </p>
                                </div>

                            </div>
                        </div>

                        <t t-set="ruba_locations" t-value="[
        {'distance': '1', 'unit': 'كلم', 'title': 'حديقة البساتين'},
        {'distance': '1', 'unit': 'كلم', 'title': 'مدارس المسارات العالمية'},
        {'distance': '2', 'unit': 'كلم', 'title': 'مسجد الراجحي'},
        {'distance': '2', 'unit': 'كلم', 'title': 'طريق الملك عبدالله'},
        {'distance': '2', 'unit': 'كلم', 'title': 'مجمع حائل سكوير'},
        {'distance': '3', 'unit': 'كلم', 'title': 'مركز الدفاع المدني'},
        {'distance': '4', 'unit': 'كلم', 'title': 'مستشفى حائل العام'},
        {'distance': '7', 'unit': 'كلم', 'title': 'مجمع الدوائر الحكومية'},
        {'distance': '10', 'unit': 'كلم', 'title': 'منطقة جبال عقدة السياحية'},
        {'distance': '13', 'unit': 'كلم', 'title': 'مطار حائل الدولي'}
    ]"/>

                        <div class="container py-5">
                            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

                                <t t-foreach="ruba_locations" t-as="location">
                                    <div class="col">
                                        <div class="s_saud_location_card d-flex gap-4 align-items-center fs-6 text-white p-3 p-md-4">
                                            <div class="s_saud_location_card_distance fw-bold lh-sm text-center">
                                                <span class="d-block" t-out="location['distance']"/>
                                                <span class="d-block" t-out="location['unit']"/>
                                            </div>

                                            <p class="s_saud_location_card_title fs-6 fw-medium mb-0"
                                               t-out="location['title']"/>
                                        </div>
                                    </div>
                                </t>

                            </div>
                        </div>

                    </section>
                    <!-- Ruba Map -->
                    <section class="s_saud_ruba_map_location ">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m13!1m8!1m3!1d14158.027056144201!2d41.655333!3d27.484611000000005!3m2!1i1024!2i768!4f13.1!3m2!1m1!2zMjfCsDI5JzA0LjYiTiA0McKwMzknMTkuMiJF!5e0!3m2!1sen!2sus!4v1779462834509!5m2!1sen!2sus"
                                height="550" style="border:0;" allowfullscreen="" loading="lazy"
                                class=" w-100"
                                referrerpolicy="no-referrer-when-downgrade">

                        </iframe>
                    </section>
                    <!-- Ruba Banner  -->
                    <t t-call="theme_saud.ruba_banner_component"/>
                    <!-- Ruba 1 States -->
                    <section class="s_saud_ruba_states mb-80">
                        <div class="container d-flex justify-content-center align-items-center flex-column">
                            <div class="s_saud_ruba_header_img py-3">
                                <img src="/theme_saud/static/src/img/RUBA-1.webp" class="w-100"
                                     alt="ruba header photo"/>
                            </div>
                            <!-- CounterUp section -->
                            <t t-call="theme_saud.counter_up_section">
                                <t t-set="counter_extra_class" t-value="''"/>
                                <t t-set="counter_main_title" t-value="''"/>
                                <t t-set="counter_main_subtitle" t-value="''"/>
                                <t t-set="counter_extra_class" t-value="'w-100 mt-0 mt-lg-5 mb-3  pt-5'"/>
                                <t t-set="counter_items" t-value="[
        {
            'icon': 'fas fa-mosque',
            'target': 11,
            'prefix': '',
            'suffix': '',
            'use_comma': False,
            'title': 'خــــــدمي'
        },
        {
            'icon': 'fas fa-store',
            'target': 50,
            'prefix': '',
            'suffix': '',
            'use_comma': False,
            'title': 'تجــــاري'
        },
        {
            'icon': 'fas fa-store-alt',
            'target': 40,
            'prefix': '',
            'suffix': '',
            'use_comma': False,
            'title': 'تجاري سكني'
        },
        {
            'icon': 'fa-solid fa-house-chimney',
            'target': 219,
            'prefix': '',
            'suffix': '',
            'use_comma': False,
            'title': 'ســكني'
        }
    ]"/>
                            </t>
                            <!-- Plan image -->
                            <section class="s_zoomable_image o_colored_level pt-5 pb-5" data-snippet="s_zoomable_image"
                                     data-name="Zoomable Image">
                                <div class="container">
                                    <div class="d-flex justify-content-center align-items-center">
                                        <div class="s_zoomable_image_wrap position-relative d-inline-block">
                                            <img src="/theme_saud/static/src/img/Ruba-plan-1.webp"
                                                 class="s_zoomable_img" alt="Image" loading="lazy"/>
                                        </div>
                                    </div>
                                </div>
                            </section>
                            <!-- Ruba Plan 1 btn link -->
                            <div class="s_saud_ruba_link d-flex align-items-center justify-content-center py-4 text-white">
                                <a class="btn btn-outline-primary"
                                   href="https://drive.google.com/file/d/1AuGniQQi2uUyjiYCRBrGKoW2ZktV02Wl/view"
                                   target="_blank">كتيب
                                    المخطط
                                </a>
                            </div>
                        </div>
                    </section>
                    <!-- Sales status -->
                    <section
                            class="s_saud_ruba_sales_status s_saud_sales_status_card mb-80 py-5 bg-body-tertiary bg-opacity-25"
                    >
                        <div class="container">
                            <div class="row align-items-center justify-content-center g-4 g-lg-5">

                                <!-- Right Content -->
                                <div class="col-12 col-lg-5">
                                    <div class="d-flex gap-4 flex-column text-center text-lg-start">
                                        <h2 class="text-primary fw-bolder">
                                            حالة مبيعات رُبى 1
                                        </h2>
                                        <p class="mb-3 lh-lg">
                                            <span class="fw-semibold d-block">الفرص تقل مع الوقت...</span>
                                            مبيعات الأراضي في المخطط تشهد إقبالاً كبيراً، مع نفاذ عدد كبير من القطع خلال
                                            أيام!
                                            <br/>
                                            اغتنم الفرصة الآن وكن جزءاً من مجتمع واعد في موقع استراتيجي.
                                        </p>

                                        <a href="https://drive.google.com/file/d/1fYT2ULMk3pq8ZKzehe58fNjWY2ljMnT8/view"
                                           target="_blank"
                                           class="btn btn-outline-primary w-100 sales-status-btn">
                                            تقرير المبيعات
                                        </a>
                                    </div>
                                </div>

                                <!-- Left Card -->
                                <div class="col-12 col-lg-5">
